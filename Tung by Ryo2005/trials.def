[TrialDef, Shou Ha]
; Tung's Projectile sctrls declare no ID. The documented projid = 0 form for ID-less projectiles
; does not register here, so these two steps stay on the stateno + isproj form, which does.
difficulty = Beginner

step.1.text = Shou Ha
step.1.glyphs = ~B_F_+^LP
step.1.stateno = 1000
step.1.isproj = true

